# Multi-Bagger Research System Environment Variables
# Copy this file to .env and add your actual API keys

# NEVER commit the actual .env file to version control!

# =============================================================================
# API KEYS (all optional for initial setup)
# =============================================================================

# Alpha Vantage (Free: 5 calls/min, 500/day)
# Get free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Financial Modeling Prep (Free: 250 calls/day)
# Get free key: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# OpenAI API (for NLP analysis in Phase 3+)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# News APIs (optional)
NEWS_API_KEY=your_news_api_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite (default - no setup required)
DATABASE_URL=sqlite:///data/multibagger.db

# PostgreSQL (alternative for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/multibagger

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable debug mode (verbose logging)
DEBUG_MODE=false

# Use sample data for testing (faster development)
SAMPLE_MODE=false
SAMPLE_SIZE=50

# Skip cache (force fresh API calls)
SKIP_CACHE=false

# =============================================================================
# MONITORING & ALERTS
# =============================================================================

# Email settings (for alerts - optional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Webhook URLs for alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# =============================================================================
# RUNTIME CONFIGURATION
# =============================================================================

# Maximum runtime for monthly job (minutes)
MAX_RUNTIME_MINUTES=60

# Number of parallel workers for data fetching
PARALLEL_WORKERS=4

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
